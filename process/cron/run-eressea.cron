#!/bin/bash

GAME=$1
(
[ "$ENABLED" == "no" ] && exit
[ -z "$ERESSEA" ] && ERESSEA="$HOME/eressea"

backup_reports()
{
	local game="$1"
	local turn="$2"
	local files=("data/$turn.dat" parteien.full parteien)
	if [ -e "orders.$turn" ]; then
			files+=("orders.$turn")
	fi
	echo "backup turn $turn, game $game, files: ${files[*]}"
	tar cjf "backup/$turn.tar.bz2" "${files[@]}"
	echo "backup reports $turn, game $game"
	tar cjf "backup/$turn-reports.tar.bz2" reports eressea.db
	echo "backup/$turn-reports.tar.bz2"
}

express()
{
	local game="$1"
	local turn="$2"
	cd "$ERESSEA/game-$game" || exit
	if [ -d express ]; then
		if [ ! -e "express-$turn.txt" ]; then
			cd express || exit
			git pull
			cd - || exit
			if [ -e "express/express-$turn.txt" ]; then
				echo "copy the express from archive"
				ln "express/express-$turn.txt" .
			else
				echo "no express for turn $turn"
			fi
		fi
	fi
}

backup()
{
	local game="$1"
	local turn="$2"
	echo "backup game $game, turn $turn"
	cd "$ERESSEA/game-$game" || exit
	if [ ! -e "data/$turn.dat" ]; then
		echo "no such file $turn.dat"
		return
	fi
	if [ ! -d backup ] ; then
		mkdir -p "$HOME/backup/eressea/game-$game"
		ln -sf "$HOME/backup/eressea/game-$game" backup
	fi

	local files=("data/$turn.dat" parteien.full parteien)
	if [ -e "orders.$turn" ]; then
		files+=("orders.$turn")
	fi
	tar cjf "backup/$turn.tar.bz2" "${files[@]}"
}

export ERESSEA
eval "$(luarocks path)"
export LUA_PATH="${ERESSEA}/server/scripts/?.lua;${ERESSEA}/server/scripts/?/init.lua;$LUA_PATH"
BIN="$ERESSEA/server/bin"
TURN=$(cat "$ERESSEA/game-$GAME/turn")
if [ ! -e "$ERESSEA/game-$GAME/data/$TURN.dat" ]; then
	echo "data file $TURN is missing, cannot run turn for game $GAME"
	exit 1
fi
REPORTS="$ERESSEA/game-$GAME/reports"
DATA="$ERESSEA/game-$GAME/data"
if [ -d "$REPORTS" ]; then
	rm -rf "$REPORTS"
fi
mkdir "$REPORTS"

cd "$ERESSEA/game-$GAME" || exit

if [ -d test ]; then
	touch test/execute.lock
fi

if [ -e "orders.$TURN" ]; then
	echo "orders.$TURN already exists"
else
	"$BIN/create-orders" "$GAME" "$TURN"
fi
if [ ! -s "orders.$TURN" ]; then
	echo "server did not create orders for turn $TURN in game $GAME"
	exit 2
fi

(( NEXTTURN=TURN+1 )) || true
## fetch the future XE:
express "$GAME" "$NEXTTURN"
## pre-game backup, data and orders only:
backup "$GAME" "$TURN"
rm -f execute.lock
"$BIN/run-turn" "$GAME" "$TURN"
echo "finished with code $?"
touch execute.lock

if [ ! -e "$DATA/$NEXTTURN.dat" ]; then
	echo "server did not create data file $NEXTTURN.dat"
	exit 5
fi
if [ ! -s "$REPORTS/reports.txt" ]; then
	echo "server did not create reports.txt in game $GAME"
	exit 4
fi
if [ ! -s "$ERESSEA/game-$GAME/data/$NEXTTURN.dat" ]; then
	echo "server did not create data for turn $NEXTTURN in game $GAME"
	exit 3
fi
echo "sending reports for game $GAME, turn $NEXTTURN"
"$BIN/compress.sh" "$GAME" "$NEXTTURN"
"$BIN/sendreports.sh" "$GAME"

echo "update mailing list"
"$BIN/updatelist.sh" "$TURN"
## post-game backup of new data:
backup "$GAME" "$NEXTTURN"
## post-game backup of reports:
backup_reports "$GAME" "$NEXTTURN"
if [ ! -f "express-$NEXTTURN.txt" ]; then
	if [ -f express.txt ]; then
	mv express.txt "express-$NEXTTURN.txt"
	fi
fi
rm -f test/execute.lock
) | tee -a "$HOME/log/eressea.cron.log"

